// Portable post-layout stimulus. Bind the locally extracted DUT and model sections.
simulator lang=spectre
global 0
include "models.local.scs"
XDUT (VSS VIN VOUT VREF) ldo_core_bleed67_v32_build1
VVIN (VIN 0) vsource dc=1.2
VVREF (VREF 0) vsource dc=0.45
VVSS (VSS 0) vsource dc=0
ILOAD (VOUT 0) isource dc=0.0001 type=pwl wave=[0 0.0001 5e-6 0.0001 5.01e-06 0.005 30e-6 0.005 3.001e-05 0.0001 60e-6 0.0001]
COUT (VOUT 0) capacitor c=1e-9
save VIN VOUT VREF VSS VVIN:p VVREF:p VVSS:p ILOAD:sink
numericalProtocolOpts options checklimitdest=psf cols=80 dcmaxiters=150 digits=5 homotopy=gmin iabstol=1e-12 maxnotes=5 maxwarns=5 newton=none pivrel=1e-3 psfversion="1.1.0" reltol=1e-5 rforce=1 scale=1.0 scalem=1.0 temp=27 tnom=27 vabstol=1e-7 precision="%.17g"
numericalProtocolSaves options save=selected currents=selected
dcOp dc write="spectre.dc" homotopy=gmin maxiters=150 newton=none
tran tran stop=60e-6 maxstep=1e-09 errpreset=conservative
