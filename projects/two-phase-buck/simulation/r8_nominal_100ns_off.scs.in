LCLOAD (CLOAD_ESR CLOAD_NODE) inductor l=CLOAD_ESL
LPDN (PDN_MID VLOAD) inductor l=L_PDN
LMAIN (CMAIN_ESR CMAIN_NODE) inductor l=COUT_ESL
L2 (SW2 LEND2) inductor l=L_PHASE
L1 (SW1 LEND1) inductor l=L_PHASE
CD_RB (CD_BIAS 0) resistor r=100k
CU_RB (CU_BIAS 0) resistor r=100k
RBOT (FB 0) resistor r=200k
RTOP (VLOAD FB) resistor r=200k
RCLOAD (VLOAD CLOAD_ESR) resistor r=CLOAD_ESR
RPDN (VCONV PDN_MID) resistor r=R_PDN
RMAIN (VCONV CMAIN_ESR) resistor r=COUT_ESR
RDCR2 (LEND2 LCONN2) resistor r=R_DCR
RDCR1 (LEND1 LCONN1) resistor r=R_DCR
IASDN (VLOAD AS_DN IAS_DN) buck_sense
IASUP (AS_UP VLOAD IAS_UP) buck_sense
IS2 (LCONN2 VCONV ISEN2) buck_sense
IS1 (LCONN1 VCONV ISEN1) buck_sense
CD_CE (CD_EA 0) capacitor c=20f
CU_CE (CU_EA 0) capacitor c=20f
CLOCAL (CLOAD_NODE 0) capacitor c=CLOAD
CMAIN (CMAIN_NODE 0) capacitor c=COUT
ILOAD (VLOAD 0) isource dc=0 type=pwl wave=[0 0 3e-06 0 5e-06 0.01 6e-05 0.01 6.01e-05 0.1 0.0001 0.1 0.0001001 0.01 0.00014 0.01]
EREFDN (REFDN_BASE 0 VREQ 0) vcvs gain=0.5
EREFUP (REFUP_BASE 0 VREQ 0) vcvs gain=0.5
