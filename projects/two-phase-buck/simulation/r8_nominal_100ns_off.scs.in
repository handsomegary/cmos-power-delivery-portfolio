CTRL (VIN VLOAD ISEN1 ISEN2 DROOP_RAW OVER_RAW IAS_UP IAS_DN VREQ CMDH1 \
        CMDL1 CMDH2 CMDL2 CMDUP CMDDN VSET IREF DUTY1 DUTY2) buck_control \
        fsw=FSW phases=PHASES assist_en=ASSIST_EN tick_s=CTRL_TICK \
        dead_s=DEAD_TIME soft_s=SOFT_START assist_blank_s=ASSIST_BLANK \
        assist_delay_s=ASSIST_DELAY assist_pulse_s=ASSIST_PULSE \
        assist_cool_s=ASSIST_COOL assist_max_pulses=ASSIST_MAX_PULSES \
        assist_limit_a=ASSIST_LIMIT phase_limit_a=PHASE_LIMIT kpv=KPV \
        kiv=KIV kpi=KPI kii=KII sense_tau_s=SENSE_TAU \
        voltage_tau_s=VOLTAGE_TAU diode_emulation=DIODE_EMULATION \
        assist_coord=ASSIST_COORD assist_boost_a=ASSIST_BOOST
simulatorOptions options psfversion="1.1.0" reltol=1e-3 vabstol=1e-6 \
    iabstol=1e-12 temp=27 tnom=27 scalem=1.0 scale=1.0 gmin=1e-12 rforce=1 \
    maxnotes=5 maxwarns=5 digits=5 cols=80 pivrel=1e-3 \
     checklimitdest=psf

ahdl_include "buck_control.va"
buckCaseOptions options temp=27 reltol=0.001 vabstol=1e-07 iabstol=1e-12
buckSaveOptions options save=allpub currents=selected subcktprobelvl=2
save IASDN:p IASUP:p IS1:p IS2:p VVDDC:p VVIN:p
tran tran stop=0.00014 skipdc=yes maxstep=2e-09 errpreset=moderate strobeperiod=2e-09 strobeoutput=strobeonly
