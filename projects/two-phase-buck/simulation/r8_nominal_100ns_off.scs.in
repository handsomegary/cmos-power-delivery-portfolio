// Circuit portfolio input. Set the model binding in the run directory.
simulator lang=spectre
global 0
parameters ASSIST_BOOST=0.04 ASSIST_COORD=0 WINDOW=0.025 ILOAD_DC=0.01 \
    CLOAD_ESL=5e-11 CLOAD_ESR=0.02 CLOAD=1e-08 L_PDN=5e-10 R_PDN=0.1 \
    COUT_ESL=2e-10 COUT_ESR=0.02 COUT=1e-06 R_DCR=0.05 L_PHASE=2.2e-06 \
    DIODE_EMULATION=1 VOLTAGE_TAU=1e-07 SENSE_TAU=1.5e-07 KII=2000000 \
    KPI=4 KIV=200000 KPV=1 PHASE_LIMIT=0.15 ASSIST_LIMIT=0.12 \
    ASSIST_MAX_PULSES=4 ASSIST_COOL=5e-08 ASSIST_PULSE=2e-07 \
    ASSIST_DELAY=1.5e-08 ASSIST_BLANK=5e-05 SOFT_START=2e-05 \
    DEAD_TIME=1e-08 CTRL_TICK=2e-09 ASSIST_EN=0 PHASES=2 FSW=5000000 \
    VOUT_REQ=0.9 VLOGIC=1.2 VIN_DC=1.8
include "models.local.scs"

